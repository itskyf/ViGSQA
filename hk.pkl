amends "package://github.com/jdx/hk/releases/download/v1.54.1/hk@1.54.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.54.1/hk@1.54.1#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["selene"] = Builtins.selene
    ["stylua"] = Builtins.stylua

    ["ruff"] = Builtins.ruff
    ["ruff_format"] = Builtins.ruff_format
    ["rumdl"] = Builtins.rumdl
    ["shellcheck"] = Builtins.shellcheck
    ["shfmt"] = Builtins.shfmt
    ["sql_fluff"] = Builtins.sql_fluff
    ["tombi"] = Builtins.tombi
    ["tombi_format"] = Builtins.tombi_format

    ["typstyle"] {
        glob = List("**/*.typ")
        check = "typstyle --check {{files}}"
        fix = "typstyle --inplace {{files}}"
        batch = true
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
